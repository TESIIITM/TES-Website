{
  "name": "tes-open-collective",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "npm run preview -- --port 4173",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "lint": "eslint .",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "verify:security": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "lucide-react": "0.577.0",
    "motion": "13.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "postcss": "8.5.29",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  }
}
