# Copy to .env.local. Without these values the site renders its bundled
# content and the admin dashboard stays disabled.
#
# Local stack: run `pnpm db:start` and copy the API URL and publishable key it prints.
# Hosted project: Project Settings → API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. GitHub allows 60 unauthenticated API requests an hour per IP, which
# a shared host can use up; a token raises that to 5,000. Create a fine-grained
# token with no permissions (public repositories only) and keep it server-side.
GITHUB_TOKEN=

# Stories are read from the Medium feed in the dashboard's Medium link as well as
# from the database. Set to "off" to show only saved stories (the e2e suite does).
MEDIUM_FEED=

# JOIN TES form (/join). Server-only: never prefix these with NEXT_PUBLIC_.
# The secret key lets the form save applications, which visitors cannot write
# with the publishable key. Local stack: the "Secret key" `pnpm db:start` prints.
# Hosted project: Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Confirmation emails over SMTP. Without SMTP_HOST, emails are skipped.
# Google Workspace / Gmail: smtp.gmail.com, port 465, and an App Password
# (needs 2-Step Verification), not the account password.
# Local test inbox (Mailpit): SMTP_HOST=127.0.0.1, SMTP_PORT=1025, no user/password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Team TES <tes@iiitm.ac.in>"
# Optional: where replies go, if not MAIL_FROM.
MAIL_REPLY_TO=

# Optional AI-assisted review with Google's Gemini API (free tier from
# aistudio.google.com). Applicants' names, roll numbers, and emails are never
# sent. Leave AI_EVAL_ENABLED empty to review by hand only.
AI_EVAL_ENABLED=
GEMINI_API_KEY=
# Any Gemini model that supports JSON output; check AI Studio for current names.
GEMINI_MODEL=gemini-2.5-flash
